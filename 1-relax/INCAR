SYSTEM = 2H-MoS2 cell relaxation, PBE+D3(BJ)

# basis and accuracy
PREC   = Accurate
ENCUT  = 450          # well above 1.3 x ENMAX(S) = 336 eV, needed when the cell changes
EDIFF  = 1E-7
LREAL  = .FALSE.

# electrons: semiconductor, small Gaussian smearing
ISMEAR = 0
SIGMA  = 0.05

# van der Waals: Grimme D3 with Becke-Johnson damping
IVDW   = 12

# relaxation of ions, cell shape and volume
IBRION = 2
ISIF   = 3
NSW    = 100
EDIFFG = -0.005       # stop when all forces are below 5 meV/Angstrom

LWAVE  = .FALSE.
LCHARG = .FALSE.
